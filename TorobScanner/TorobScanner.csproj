<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- ساخت پروژه روی هر سیستمی (لینوکس/مک/CI) بدون ویندوز -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyTitle>Torob Intelligence Pro</AssemblyTitle>
    <Version>2.0.0</Version>
    <Product>Torob Intelligence Pro</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="8.6.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Playwright" Version="1.60.0" />
  </ItemGroup>

</Project>
