<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         ✨ BazarSanj — استایل‌های کنترلی v2.8 (تم‌محور)
         پالت رنگ + توکن‌های سبک (شعاع، خط دور، سایه، hover) از LuxPalette.xaml
         می‌آیند (DynamicResource) → تعویض تم توسط ThemeService بدون ری‌استارت،
         نه فقط رنگ که «شکل» همه‌ی کنترل‌ها را هم زنده عوض می‌کند.
         ═══════════════════════════════════════════════════════════════ -->

    <!-- ═══════════ Button — استایل شیشه‌ای سراسری ═══════════ -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource LuxGlassFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LuxGlassStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="pressRoot" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <!-- ✨ v2.6: میکروتعامل فشردن — دکمه هنگام کلیک نرم جمع می‌شود -->
                            <ScaleTransform x:Name="pressScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource LuxBtnRadius}"/>
                        <Border x:Name="hoverLayer" Background="{DynamicResource LuxHoverLayer}" Opacity="0" CornerRadius="{DynamicResource LuxBtnRadius}"
                                IsHitTestVisible="False"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.09" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="hoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="hoverLayer" Property="Background" Value="#000000"/>
                            <Setter TargetName="hoverLayer" Property="Opacity" Value="0.18"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="pressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.97" Duration="0:0:0.09"/>
                                        <DoubleAnimation Storyboard.TargetName="pressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.97" Duration="0:0:0.09"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="pressScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="pressScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- دکمه اصلی (گرادیان متالیک تم + متن کنتراست از سبک) -->
    <Style x:Key="LuxBtnPrimary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource LuxPlatinumMetal}"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxPrimaryBtnText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LuxPrimaryBtnStroke}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- دکمه شبح (فقط خط دور) -->
    <Style x:Key="LuxBtnGhost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource LuxGhostFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LuxGlassStroke}"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxTextSecondary}"/>
    </Style>

    <!-- دکمه خطر -->
    <Style x:Key="LuxBtnDanger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource LuxDangerFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LuxDangerBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxDangerText}"/>
    </Style>

    <!-- دکمه موفق -->
    <Style x:Key="LuxBtnSuccess" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource LuxSuccessFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LuxSuccessBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxSuccessText}"/>
    </Style>

    <!-- دکمه توقف (عملیات طولانی) -->
    <Style x:Key="LuxBtnStop" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource LuxStopFill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LuxStopBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxDangerText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- دکمه‌های نوار عنوان پنجره -->
    <Style x:Key="LuxTitleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxTextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>
    <Style x:Key="LuxTitleCloseButton" TargetType="Button" BasedOn="{StaticResource LuxTitleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="Transparent" CornerRadius="{DynamicResource LuxBtnRadius}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#38FF6B6B"/>
                            <Setter Property="Foreground" Value="{DynamicResource LuxDangerText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ TextBox — شیشه‌ای ═══════════ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource LuxGlassFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LuxGlassStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource LuxPlatinum}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource LuxSelection}"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource LuxInputRadius}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LuxFocusStroke}"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource LuxGlassFillStrong}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ ComboBox — شیشه‌ای با فلش Chevron ═══════════ -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource LuxGlassFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LuxGlassStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,0,10,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource LuxInputRadius}">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton" Focusable="false"
                                              IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press" Background="Transparent" BorderThickness="0"/>
                                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                  HorizontalAlignment="Right"/>
                                <Path x:Name="chev" Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="{DynamicResource LuxTextDim}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,1,0,0"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="Popup" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Grid x:Name="DropDown" SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,6,0,0">
                                <Border Background="{DynamicResource LuxPopupBg}" BorderBrush="{DynamicResource LuxGlassStroke}" BorderThickness="{DynamicResource LuxCardBorderThick}"
                                        CornerRadius="{DynamicResource LuxCardRadius}"
                                        Effect="{DynamicResource LuxShadowDialog}"/>
                                <ScrollViewer Margin="6" SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource LuxGlassFillStrong}"/>
                        </Trigger>
                        <Trigger SourceName="ToggleButton" Property="IsMouseOver" Value="True">
                            <Setter TargetName="chev" Property="Stroke" Value="{DynamicResource LuxAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource LuxTextPrimary}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource LuxInputRadius}" Padding="{TemplateBinding Padding}"
                            Margin="2,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource LuxHoverFill}"/>
                            <Setter Property="Foreground" Value="{DynamicResource LuxAccent}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource LuxSelectedFill}"/>
                            <Setter Property="Foreground" Value="{DynamicResource LuxSelectedText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ ProgressBar — نوار شیشه‌ای با گرادیان ═══════════ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="5"/>
        <Setter Property="Background" Value="{DynamicResource LuxGlassFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxIridescent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                HorizontalAlignment="Left">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="indTx" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <!-- ✨ انیمیشن indeterminate — جریان نرم نور روی شیشه -->
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Width" Value="64"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="indTx" Storyboard.TargetProperty="X"
                                                         From="-80" To="700" Duration="0:0:1.15"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="indTx" Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ ListBox ═══════════ -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxTextPrimary}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource LuxTextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource LuxBtnRadius}" Padding="10,7" Margin="1,2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource LuxHoverFill}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource LuxSelectedFill}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ DataGrid — شیشه‌ای ═══════════ -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxTextPrimary}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource LuxGridLine}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="EnableColumnVirtualization" Value="True"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource LuxSeparator}"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxTextSecondary}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LuxSeparator}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource LuxHoverFill}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource LuxSelectedFill}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxTextPrimary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LuxTextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════ ScrollBar — باریک و پلاتینیومی ═══════════ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumbBd" Background="{DynamicResource LuxScrollThumb}" CornerRadius="{DynamicResource LuxPillRadius}" Margin="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumbBd" Property="Background" Value="{DynamicResource LuxScrollThumbHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="thumbBd" Property="Background" Value="{DynamicResource LuxScrollThumbDrag}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            <Setter Property="Height" Value="8"/>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ ToolTip / Separator ═══════════ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource LuxPopupBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource LuxTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LuxGlassStroke}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource LuxInputRadius}" Padding="11,7">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource LuxSeparator}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,14,0,12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1" CornerRadius="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
